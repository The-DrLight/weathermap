# Lagos coordinates (fallback defaults; the frontend can override per-request via lat/lon query params)
LAGOS_LAT=6.5244
LAGOS_LON=3.3792

# Open-Meteo API (no key required)
OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# NASA POWER API (no key required)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/hourly/point

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Model path
MODEL_PATH=models/rain_model.joblib
